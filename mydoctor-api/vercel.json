{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python3 -m pip install --upgrade pip && python3 -m pip install -r requirements.txt",
  "buildCommand": "python3 manage.py collectstatic --noinput",
  "builds": [
    {
      "src": "projeto/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "todos/static/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "projeto/wsgi.py"
    }
  ]
}
